# Copy this file to client/.env. Only VITE_* variables reach the browser,
# and everything here is public — never put secrets in this file.

# Base URL of the OpenChat server (no trailing slash, no /api)
VITE_API_URL=http://localhost:5000

# The site's own address at deploy (https, no trailing slash), for link
# previews, the canonical link, robots.txt and sitemap.xml. Leave unset in
# development.
# VITE_SITE_URL=https://openchat.example
