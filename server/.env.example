# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Port the API + Socket.IO server listens on (client/.env VITE_API_URL must point here)
PORT=5000

# MongoDB connection string, including the database name
MONGO_URI=mongodb://localhost:27017/openchat

# Secret used to sign login tokens. At least 32 random characters, e.g. generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Exact origin of the React app (used for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# Set to "production" in production (enables Secure cookies)
# NODE_ENV=production

# Where uploaded files are stored: "local" (default) or "cloudinary". Files
# are encrypted in the browser, so the store only holds unreadable bytes.
# STORAGE_DRIVER=local
# Folder for the local driver (default: server/uploads, git-ignored)
# UPLOADS_DIR=/var/lib/openchat/uploads

# Cloudinary (only with STORAGE_DRIVER=cloudinary). From the Cloudinary
# console, "API Keys". The secret stays on the server: never in client/.env.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder in Cloudinary (default: openchat)
# CLOUDINARY_FOLDER=openchat

# Number of proxies in front of the server (the host's load balancer), so rate
# limits see the real client address. 0 in development; never more than the
# real number (clients could then fake their address).
# TRUST_PROXY=1
# Rate limits are always on. "off" is only for the test suites and is refused
# when NODE_ENV=production.
# RATE_LIMITS=on

# Cloudflare Realtime TURN (optional): relays calls the two browsers can't
# connect directly (routers without hairpinning, strict mobile/office
# networks). A TURN key from the Cloudflare dashboard; the token stays on the
# server, browsers get short-lived credentials per call. Both or neither.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=

# Sign in with Google (optional; docs/DEPLOY.md step 3c). Both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign-up codes by email through Brevo (docs/DEPLOY.md step 3d). Both or
# neither. Without them, development prints the code in the console and
# production offers only Google for new accounts.
# BREVO_API_KEY=
# EMAIL_FROM=

# Web Push: notifications while OpenChat is closed (docs/DEPLOY.md step 3e).
# Make a pair once with: npx web-push generate-vapid-keys  (both or neither)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
